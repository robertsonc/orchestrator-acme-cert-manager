# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
# Keep values unquoted. If edited on Windows, strip CRs: sed -i 's/\r$//' .env

# --- Where the server list lives inside the container (persistent bind mount) ---
SERVERS_FILE=/config/servers.json

# --- Cloudflare DNS-01 (Lego reads this name) ---
# Fallback used when a server has no inline token set in the web UI.
CF_DNS_API_TOKEN=your-cloudflare-api-token

# --- Orchestrator REST API key (OrchestratorAdmin, Read/Write) ---
# Fallback used when a server has no inline key set in the web UI.
ORCH_API_KEY=your-orchestrator-api-key

# --- Container timezone (affects cron + logs) ---
TZ=America/New_York

# --- Failure alerting (optional) ---
# Incoming-webhook URL (Slack/Discord/Teams/generic). Leave blank to disable.
NOTIFY_WEBHOOK_URL=
# "failed" (default) alerts only on failures; "all" also announces renewals.
NOTIFY_ON=failed

# --- Startup strictness ---
# "true" (default): refuse to start when the config path is not persistently
# mounted or only a legacy /data/servers.json exists. "false" logs a warning.
STRICT_STARTUP=true
